<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- This foundation has no network feature. Remove transitive SDK grants. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <queries>
        <package android:name="com.antiscam.fixture" />
        <package android:name="com.google.android.apps.messaging" />
        <package android:name="com.google.android.gm" />
        <package android:name="com.whatsapp" />
        <package android:name="com.facebook.orca" />
        <package android:name="com.facebook.katana" />
    </queries>
    <application
        android:allowBackup="false"
        android:label="Antiscam Dev"
        android:supportsRtl="true"
        android:theme="@style/Theme.Antiscam">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".capture.TypingCaptureService"
            android:exported="true"
            android:label="Antiscam typing capture"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/typing_capture_service" />
        </service>
    </application>
</manifest>
